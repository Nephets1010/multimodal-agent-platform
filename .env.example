# ============================================================
# 配置模板：复制为 .env 后按需填写。
# 本文件仅含占位符，严禁提交任何真实凭据 / Token / 密钥。
# DEMO_MODE=1 时即使填写了 API Key 也绝不会发起任何网络请求。
#
# 环境变量两种写法（长格式必须带 MAP_ 前缀，避免与宿主环境注入的
# SERVER__HOST / SERVER__PORT 等无关同名变量冲突）：
#   ① 规格 §4.6 历史短别名（优先，不带前缀）：DEMO_MODE / HOST / PORT /
#      LLM_BACKEND / ENCODER_BACKEND / VECTOR_BACKEND / HUMAN_IN_LOOP / LLM_API_KEY ...
#   ② 项目前缀长格式：MAP_<SECTION>__<KEY>，例如
#      MAP_SERVER__HOST=127.0.0.1、MAP_AGENT__MAX_STEPS=8、MAP_RETRIEVAL__DENSE_WEIGHT=0.7
# 注意：不带 MAP_ 前缀的 SERVER__HOST 等变量不会被本平台读取。
# ============================================================

# 演示模式开关（1=DEMO，0=生产）
DEMO_MODE=1

# 监听地址与端口（默认 0.0.0.0:8000；暴露公网有风险，见 README）
HOST=
PORT=

# ---- LLM（OpenAI 兼容端点，httpx 直连，不用 openai SDK）----
LLM_BACKEND=template
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_VISION_MODEL=

# ---- 表征 / 向量库 ----
ENCODER_BACKEND=stub
ENCODER_LOCAL_MODEL_PATH=
VECTOR_BACKEND=memory

# ---- Agent ----
AGENT_MAX_STEPS=
AGENT_TOOL_TIMEOUT_SECONDS=
HUMAN_IN_LOOP=
